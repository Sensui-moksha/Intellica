# =============================================================================
# 🚀 INTELLICA MONOREPO - .gitignore
# =============================================================================

# ── 1. DEPENDENCIES ──
node_modules/
*/node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ── 2. ENVIRONMENT & CREDENTIALS ──
# Never commit actual secret keys, passwords, or MongoDB URIs
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env

# Allow example/template files
!.env.example
!backend/.env.example
!frontend/.env.example

# ── 3. BUILD OUTPUTS & BUNDLES ──
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
out/
.output/
.cache/
.vite/
*/.vite/

# ── 4. RUNTIME UPLOADS & FILE STORAGE ──
# Local user uploads (PDFs, certificates, proofs)
backend/uploads/
uploads/
*/uploads/
!backend/uploads/.gitkeep

# ── 5. LOGS & DIAGNOSTICS ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ── 6. OS & SYSTEM ARTIFACTS ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ── 7. IDE & EDITOR CONFIGURATIONS ──
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── 8. TESTING & COVERAGE ──
coverage/
.nyc_output/
*.lcov

# ── 9. TEMPORARY & SCRATCH FILES ──
tmp/
temp/
scratch/
.system_generated/
