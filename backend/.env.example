# =============================================================================
# 🚀 INTELLICA BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your real credentials.
# =============================================================================

# ── 1. SERVER CONFIGURATION ──
PORT=5001
NODE_ENV=development

# ── 2. DATABASE (MONGODB) ──
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ── 3. AUTHENTICATION & SECURITY SECRETS ──
JWT_SECRET=your_super_secret_jwt_key_here
SESSION_SECRET=your_super_secret_session_encryption_key_here

# ── 4. EMAIL & OTP NOTIFICATIONS (GMAIL SMTP) ──
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_gmail_app_password
# EMAIL_LOGO_URL=https://yourcollege.edu/logo.png

# ── 5. STORAGE & UPLOADS DIRECTORY ──
UPLOAD_DIR=./uploads

# ── 6. MONOREPO DYNAMIC AUTO-CONFIGURATION (OPTIONAL OVERRIDES) ──
# FRONTEND_PORT=5173
# ALLOWED_ORIGINS=https://intellica.yourcollege.edu

# ── 7. DATABASE AUTO-SEEDER ──
# Set to 'true' to automatically seed/verify default admin, HOD, categories, and credit rules on startup
SEEDER=true
